          "children": { "explicitList": ["tcp-card"] }
        }
      }
    },
    {
      "id": "tcp-card",
      "component": {
        "Card": {
          "child": "tcp-col"
        }
      }
    },
    {
      "id": "tcp-col",
      "component": {
        "Column": {
          "children": { "explicitList": ["tcp-title", "tcp-value-row", "tcp-description"] }
        }
