{
  "root": "app-container",
  "components": [
    {
      "id": "app-container",
      "component": {
        "Column": {
          "children": { "explicitList": ["header", "nav-row", "main-content"] }
        }
      }
    },
    {
      "id": "header",
      "component": {
        "Card": {
          "child": "header-content"
        }
      }
    },
    {
      "id": "header-content",
      "component": {
        "Row": {
          "distribution": "spaceBetween",
          "children": { "explicitList": ["app-title", "status-badge"] }
        }
      }
    },
    {
      "id": "app-title",
      "component": {
        "Text": {
          "text": { "path": "/appName" },
          "usageHint": "h1"
        }
      }
    },
    {
      "id": "status-badge",
      "component": {
        "Text": {
          "text": { "path": "/status" },
          "usageHint": "caption"
        }
      }
    },
    {
      "id": "nav-row",
      "component": {
        "Row": {
          "children": { "explicitList": ["nav-btn-task", "nav-btn-progress", "nav-btn-agents", "nav-btn-tests", "nav-btn-tcp"] }
        }
      }
    },
    {
      "id": "nav-btn-task",
      "component": {
        "Button": {
          "child": "nav-btn-task-text",
          "action": { "name": "navigate", "parameters": { "view": "taskForm" } }
        }
      }
    },
    {
      "id": "nav-btn-task-text",
      "component": {
        "Text": {
          "text": { "literalString": "New Task" }
        }
      }
    },
    {
      "id": "nav-btn-progress",
      "component": {
        "Button": {
          "child": "nav-btn-progress-text",
          "action": { "name": "navigate", "parameters": { "view": "progress" } }
        }
      }
    },
    {
      "id": "nav-btn-progress-text",
      "component": {
        "Text": {
          "text": { "literalString": "Progress" }
        }
      }
    },
    {
      "id": "nav-btn-agents",
      "component": {
        "Button": {
          "child": "nav-btn-agents-text",
          "action": { "name": "navigate", "parameters": { "view": "agents" } }
        }
      }
    },
    {
      "id": "nav-btn-agents-text",
      "component": {
        "Text": {
          "text": { "literalString": "Agents" }
        }
      }
    },
    {
      "id": "nav-btn-tests",
      "component": {
        "Button": {
          "child": "nav-btn-tests-text",
          "action": { "name": "navigate", "parameters": { "view": "tests" } }
        }
      }
    },
    {
      "id": "nav-btn-tests-text",
      "component": {
        "Text": {
          "text": { "literalString": "Tests" }
        }
      }
    },
    {
      "id": "nav-btn-tcp",
      "component": {
        "Button": {
          "child": "nav-btn-tcp-text",
          "action": { "name": "navigate", "parameters": { "view": "tcp" } }
        }
      }
    },
    {
      "id": "nav-btn-tcp-text",
      "component": {
        "Text": {
          "text": { "literalString": "TCP Signal" }
        }
      }
    },
    {
      "id": "main-content",
      "component": {
        "Row": {
          "children": { "explicitList": ["left-panel", "center-panel", "right-panel"] }
        }
      }
    },
    {
      "id": "left-panel",
      "component": {
        "Column": {
          "children": { "explicitList": ["task-card", "agent-card"] }
        }
      }
    },
    {
      "id": "task-card",
      "component": {
        "Card": {
          "child": "task-form-col"
        }
      }
    },
    {
      "id": "task-form-col",
      "component": {
        "Column": {
          "children": { "explicitList": ["task-title", "task-field", "task-submit-row"] }
        }
      }
    },
    {
      "id": "task-title",
      "component": {
        "Text": {
          "text": { "literalString": "Create New Task" },
          "usageHint": "h2"
        }
      }
    },
    {
      "id": "task-field",
      "component": {
        "TextField": {
          "label": { "literalString": "Description" },
          "text": { "path": "/task/description" }
        }
      }
    },
    {
      "id": "task-submit-row",
      "component": {
        "Row": {
          "distribution": "end",
          "children": { "explicitList": ["task-submit-btn"] }
        }
      }
    },
    {
      "id": "task-submit-btn",
      "component": {
        "Button": {
          "child": "task-submit-btn-text",
          "action": { "name": "submitTask" }
        }
      }
    },
    {
      "id": "task-submit-btn-text",
      "component": {
        "Text": {
          "text": { "literalString": "Submit Task" }
        }
      }
    },
    {
      "id": "agent-card",
      "component": {
        "Card": {
          "child": "agent-col"
        }
      }
    },
    {
      "id": "agent-col",
      "component": {
        "Column": {
          "children": { "explicitList": ["agent-header", "agent-status", "agent-metrics"] }
        }
      }
    },
    {
      "id": "agent-header",
      "component": {
        "Row": {
          "distribution": "spaceBetween",
          "children": { "explicitList": ["agent-name", "agent-role"] }
        }
      }
    },
    {
      "id": "agent-name",
      "component": {
        "Text": {
          "text": { "path": "/agent/name" },
          "usageHint": "h3"
        }
      }
    },
    {
      "id": "agent-role",
      "component": {
        "Text": {
          "text": { "path": "/agent/role" },
          "usageHint": "caption"
        }
      }
    },
    {
      "id": "agent-status",
      "component": {
        "Row": {
          "children": { "explicitList": ["agent-status-label", "agent-status-value"] }
        }
      }
    },
    {
      "id": "agent-status-label",
      "component": {
        "Text": {
          "text": { "literalString": "Status: " }
        }
      }
    },
    {
      "id": "agent-status-value",
      "component": {
        "Text": {
          "text": { "path": "/agent/status" }
        }
      }
    },
    {
      "id": "agent-metrics",
      "component": {
        "Row": {
          "distribution": "spaceEvenly",
          "children": { "explicitList": ["metric-iterations", "metric-tests"] }
        }
      }
    },
    {
      "id": "metric-iterations",
      "component": {
        "Column": {
          "children": { "explicitList": ["metric-iterations-value", "metric-iterations-label"] }
        }
      }
    },
    {
      "id": "metric-iterations-value",
      "component": {
        "Text": {
          "text": { "path": "/agent/iterations" },
          "usageHint": "h2"
        }
      }
    },
    {
      "id": "metric-iterations-label",
      "component": {
        "Text": {
          "text": { "literalString": "Iterations" },
          "usageHint": "caption"
        }
      }
    },
    {
      "id": "metric-tests",
      "component": {
        "Column": {
          "children": { "explicitList": ["metric-tests-value", "metric-tests-label"] }
        }
      }
    },
    {
      "id": "metric-tests-value",
      "component": {
        "Text": {
          "text": { "path": "/agent/testsPassed" },
          "usageHint": "h2"
        }
      }
    },
    {
      "id": "metric-tests-label",
      "component": {
        "Text": {
          "text": { "literalString": "Tests Passed" },
          "usageHint": "caption"
        }
      }
    },
    {
      "id": "center-panel",
      "component": {
        "Column": {
          "children": { "explicitList": ["progress-card", "test-results-card"] }
        }
      }
    },
    {
      "id": "progress-card",
      "component": {
        "Card": {
          "child": "progress-col"
        }
      }
    },
    {
      "id": "progress-col",
      "component": {
        "Column": {
          "children": { "explicitList": ["progress-title", "progress-steps"] }
        }
      }
    },
    {
      "id": "progress-title",
      "component": {
        "Text": {
          "text": { "literalString": "Progress" },
          "usageHint": "h3"
        }
      }
    },
    {
      "id": "progress-steps",
      "component": {
        "Row": {
          "distribution": "spaceEvenly",
          "children": { "explicitList": ["step-1", "arrow-1", "step-2", "arrow-2", "step-3", "arrow-3", "step-4", "arrow-4", "step-5"] }
        }
      }
    },
    {
      "id": "step-1",
      "component": {
        "Column": {
          "children": { "explicitList": ["step-1-icon", "step-1-label"] }
        }
      }
    },
    {
      "id": "step-1-icon",
      "component": {
        "Text": {
          "text": { "path": "/progress/steps/0/icon" }
        }
      }
    },
    {
      "id": "step-1-label",
      "component": {
        "Text": {
          "text": { "path": "/progress/steps/0/label" },
          "usageHint": "caption"
        }
      }
    },
    {
      "id": "arrow-1",
      "component": {
        "Text": {
          "text": { "literalString": "→" }
        }
      }
    },
    {
      "id": "step-2",
      "component": {
        "Column": {
          "children": { "explicitList": ["step-2-icon", "step-2-label"] }
        }
      }
    },
    {
      "id": "step-2-icon",
      "component": {
        "Text": {
          "text": { "path": "/progress/steps/1/icon" }
        }
      }
    },
    {
      "id": "step-2-label",
      "component": {
        "Text": {
          "text": { "path": "/progress/steps/1/label" },
          "usageHint": "caption"
        }
      }
    },
    {
      "id": "arrow-2",
      "component": {
        "Text": {
          "text": { "literalString": "→" }
        }
      }
    },
    {
      "id": "step-3",
      "component": {
        "Column": {
          "children": { "explicitList": ["step-3-icon", "step-3-label"] }
        }
      }
    },
    {
      "id": "step-3-icon",
      "component": {
        "Text": {
          "text": { "path": "/progress/steps/2/icon" }
        }
      }
    },
    {
      "id": "step-3-label",
      "component": {
        "Text": {
          "text": { "path": "/progress/steps/2/label" },
          "usageHint": "caption"
        }
      }
    },
    {
      "id": "arrow-3",
      "component": {
        "Text": {
          "text": { "literalString": "→" }
        }
      }
    },
    {
      "id": "step-4",
      "component": {
        "Column": {
          "children": { "explicitList": ["step-4-icon", "step-4-label"] }
        }
      }
    },
    {
      "id": "step-4-icon",
      "component": {
        "Text": {
          "text": { "path": "/progress/steps/3/icon" }
        }
      }
    },
    {
      "id": "step-4-label",
      "component": {
        "Text": {
          "text": { "path": "/progress/steps/3/label" },
          "usageHint": "caption"
        }
      }
    },
    {
      "id": "arrow-4",
      "component": {
        "Text": {
          "text": { "literalString": "→" }
        }
      }
    },
    {
      "id": "step-5",
      "component": {
        "Column": {
          "children": { "explicitList": ["step-5-icon", "step-5-label"] }
        }
      }
    },
    {
      "id": "step-5-icon",
      "component": {
        "Text": {
          "text": { "path": "/progress/steps/4/icon" }
        }
      }
    },
    {
      "id": "step-5-label",
      "component": {
        "Text": {
          "text": { "path": "/progress/steps/4/label" },
          "usageHint": "caption"
        }
      }
    },
    {
      "id": "test-results-card",
      "component": {
        "Card": {
          "child": "test-results-col"
        }
      }
    },
    {
      "id": "test-results-col",
      "component": {
        "Column": {
          "children": { "explicitList": ["test-results-header", "test-results-summary"] }
        }
      }
    },
    {
      "id": "test-results-header",
      "component": {
        "Row": {
          "distribution": "spaceBetween",
          "children": { "explicitList": ["test-results-title", "test-results-time"] }
        }
      }
    },
    {
      "id": "test-results-title",
      "component": {
        "Text": {
          "text": { "literalString": "Test Results" },
          "usageHint": "h3"
        }
      }
    },
    {
      "id": "test-results-time",
      "component": {
