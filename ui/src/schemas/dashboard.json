{
  "root": "app-container",
  "includes": [
    "header",
    "navigation",
    "taskForm",
    "agentCard",
    "progressStepper",
    "testResults",
    "tcpGauge"
  ],
  "layout": [
    {
      "id": "app-container",
      "component": {
        "Column": {
          "children": { "explicitList": ["header", "nav-row", "main-content"] }
        }
      }
    },
    {
      "id": "main-content",
      "component": {
        "Row": {
          "children": { "explicitList": ["left-panel", "center-panel", "right-panel"] }
        }
      }
    },
    {
      "id": "left-panel",
      "component": {
        "Column": {
          "children": { "explicitList": ["task-card", "agent-card"] }
        }
      }
    },
    {
      "id": "center-panel",
      "component": {
        "Column": {
          "children": { "explicitList": ["progress-card", "test-results-card"] }
        }
      }
    },
    {
      "id": "right-panel",
      "component": {
        "Column": {
          "children": { "explicitList": ["tcp-card"] }
        }
      }
    }
  ],
  "defaultData": {
    "appName": "ForgeMaster",
    "status": "Ready",
    "task": {
      "description": ""
    },
    "agent": {
      "name": "CodeGen Agent",
      "role": "Code Generator",
      "status": "Idle",
      "iterations": "0",
      "testsPassed": "0/0"
    },
    "progress": {
      "steps": [
        { "icon": "🔍", "label": "Analyze" },
        { "icon": "📝", "label": "Gen Tests" },
        { "icon": "⚙️", "label": "Gen Code" },
        { "icon": "🧪", "label": "Run Tests" },
        { "icon": "✅", "label": "Complete" }
      ]
    },
    "tests": {
      "runTime": "0.0s",
      "passed": "0",
      "failed": "0",
      "skipped": "0"
    },
    "tcp": {
      "value": "0.00",
      "description": "Test Case Passing ratio"
    }
  }
}
