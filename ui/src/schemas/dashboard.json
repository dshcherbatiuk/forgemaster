{
  "root": "app-container",
  "includes": [
    "header",
    "taskForm"
  ],
  "layout": [
    {
      "id": "app-container",
      "component": {
        "Column": {
          "children": { "explicitList": ["header", "hero-section"] }
        }
      }
    },
    {
      "id": "hero-section",
      "component": {
        "Column": {
          "children": { "explicitList": ["hero-tagline", "hero-subtitle", "task-card"] }
        }
      }
    },
    {
      "id": "hero-tagline",
      "component": {
        "Text": {
          "text": { "path": "/hero/tagline" },
          "usageHint": "h1"
        }
      }
    },
    {
      "id": "hero-subtitle",
      "component": {
        "Text": {
          "text": { "path": "/hero/subtitle" },
          "usageHint": "body"
        }
      }
    }
  ],
  "defaultData": {
    "appName": "ForgeMaster",
    "hero": {
      "tagline": "AI-Powered Code Generation",
      "subtitle": "Describe your task. Let agents build it. Tests drive the loop."
    },
    "task": {
      "description": ""
    }
  }
}
