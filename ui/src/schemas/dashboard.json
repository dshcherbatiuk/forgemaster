    {
      "id": "tests-skipped",
      "component": {
        "Column": {
          "children": { "explicitList": ["tests-skipped-value", "tests-skipped-label"] }
        }
      }
    },
    {
      "id": "tests-skipped-value",
      "component": {
        "Text": {
          "text": { "path": "/tests/skipped" },
          "usageHint": "h2"
        }
      }
    },
    {
      "id": "tests-skipped-label",
      "component": {
        "Text": {
          "text": { "literalString": "Skipped" },
