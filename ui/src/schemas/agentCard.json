{
  "root": "card-1",
  "components": [
    {
      "id": "card-1",
      "component": {
        "Card": {
          "child": "col-1"
        }
      }
    },
    {
      "id": "col-1",
      "component": {
        "Column": {
          "children": { "explicitList": ["header-row", "status-row", "metrics-row"] }
        }
      }
    },
    {
      "id": "header-row",
      "component": {
        "Row": {
          "distribution": "spaceBetween",
          "children": { "explicitList": ["agent-name", "agent-role"] }
        }
      }
    },
    {
      "id": "agent-name",
      "component": {
        "Text": {
          "text": { "path": "/name" },
          "usageHint": "h3"
        }
      }
    },
    {
      "id": "agent-role",
      "component": {
        "Text": {
          "text": { "path": "/role" },
          "usageHint": "caption"
        }
      }
    },
    {
      "id": "status-row",
      "component": {
        "Row": {
          "children": { "explicitList": ["status-label", "status-value"] }
        }
      }
    },
    {
      "id": "status-label",
      "component": {
        "Text": {
          "text": { "literalString": "Status: " }
        }
      }
    },
    {
      "id": "status-value",
      "component": {
        "Text": {
          "text": { "path": "/status" }
        }
      }
    },
    {
      "id": "metrics-row",
      "component": {
        "Row": {
          "distribution": "spaceEvenly",
          "children": { "explicitList": ["iterations-col", "tests-col", "tcp-col"] }
        }
      }
    },
    {
      "id": "iterations-col",
      "component": {
        "Column": {
          "children": { "explicitList": ["iterations-value", "iterations-label"] }
        }
      }
    },
    {
      "id": "iterations-value",
      "component": {
        "Text": {
          "text": { "path": "/metrics/iterations" },
          "usageHint": "h2"
        }
      }
    },
    {
      "id": "iterations-label",
      "component": {
        "Text": {
          "text": { "literalString": "Iterations" },
          "usageHint": "caption"
        }
      }
    },
    {
      "id": "tests-col",
      "component": {
        "Column": {
          "children": { "explicitList": ["tests-value", "tests-label"] }
        }
      }
    },
    {
      "id": "tests-value",
      "component": {
        "Text": {
          "text": { "path": "/metrics/testsPassed" },
          "usageHint": "h2"
        }
      }
    },
    {
      "id": "tests-label",
      "component": {
        "Text": {
          "text": { "literalString": "Tests Passed" },
          "usageHint": "caption"
        }
      }
    },
    {
      "id": "tcp-col",
      "component": {
        "Column": {
          "children": { "explicitList": ["tcp-value", "tcp-label"] }
        }
      }
    },
    {
      "id": "tcp-value",
      "component": {
        "Text": {
          "text": { "path": "/metrics/tcp" },
          "usageHint": "h2"
        }
      }
    },
    {
      "id": "tcp-label",
      "component": {
        "Text": {
          "text": { "literalString": "TCP" },
          "usageHint": "caption"
        }
      }
    }
  ],
  "defaultData": {
    "name": "CodeGen Agent",
    "role": "Code Generator",
    "status": "Running",
    "metrics": {
      "iterations": "3",
      "testsPassed": "12/15",
      "tcp": "0.85"
    }
  }
}
