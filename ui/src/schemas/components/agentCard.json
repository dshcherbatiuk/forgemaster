{
  "id": "agent-card",
  "components": [
    {
      "id": "agent-card",
      "component": {
        "Card": {
          "child": "agent-col"
        }
      }
    },
    {
      "id": "agent-col",
      "component": {
        "Column": {
          "children": { "explicitList": ["agent-header", "agent-status", "agent-metrics"] }
        }
      }
    },
    {
      "id": "agent-header",
      "component": {
        "Row": {
          "distribution": "spaceBetween",
          "children": { "explicitList": ["agent-name", "agent-role"] }
        }
      }
    },
    {
      "id": "agent-name",
      "component": {
        "Text": {
          "text": { "path": "/agent/name" },
          "usageHint": "h3"
        }
      }
    },
    {
      "id": "agent-role",
      "component": {
        "Text": {
          "text": { "path": "/agent/role" },
          "usageHint": "caption"
        }
      }
    },
    {
      "id": "agent-status",
      "component": {
        "Row": {
          "children": { "explicitList": ["agent-status-label", "agent-status-value"] }
        }
      }
    },
    {
      "id": "agent-status-label",
      "component": {
        "Text": {
          "text": { "literalString": "Status: " }
        }
      }
    },
    {
      "id": "agent-status-value",
      "component": {
        "Text": {
          "text": { "path": "/agent/status" }
        }
      }
    },
    {
      "id": "agent-metrics",
      "component": {
        "Row": {
          "distribution": "spaceEvenly",
          "children": { "explicitList": ["metric-iterations", "metric-tests"] }
        }
      }
    },
    {
      "id": "metric-iterations",
      "component": {
        "Column": {
          "children": { "explicitList": ["metric-iterations-value", "metric-iterations-label"] }
        }
      }
    },
    {
      "id": "metric-iterations-value",
      "component": {
        "Text": {
          "text": { "path": "/agent/iterations" },
          "usageHint": "h2"
        }
      }
    },
    {
      "id": "metric-iterations-label",
      "component": {
        "Text": {
          "text": { "literalString": "Iterations" },
          "usageHint": "caption"
        }
      }
    },
    {
      "id": "metric-tests",
      "component": {
        "Column": {
          "children": { "explicitList": ["metric-tests-value", "metric-tests-label"] }
        }
      }
    },
    {
      "id": "metric-tests-value",
      "component": {
        "Text": {
          "text": { "path": "/agent/testsPassed" },
          "usageHint": "h2"
        }
      }
    },
    {
      "id": "metric-tests-label",
      "component": {
        "Text": {
          "text": { "literalString": "Tests Passed" },
          "usageHint": "caption"
        }
      }
    }
  ]
}
