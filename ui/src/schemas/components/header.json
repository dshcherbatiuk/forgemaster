{
  "id": "header",
  "components": [
    {
      "id": "header",
      "component": {
        "Column": {
          "children": { "explicitList": ["header-row", "header-divider"] }
        }
      }
    },
    {
      "id": "header-row",
      "component": {
        "Row": {
          "distribution": "spaceBetween",
          "alignment": "center",
          "children": { "explicitList": ["app-title"] }
        }
      }
    },
    {
      "id": "app-title",
      "component": {
        "Text": {
          "text": { "path": "/appName" },
          "usageHint": "h2"
        }
      }
    },
    {
      "id": "header-divider",
      "component": {
        "Divider": {
          "axis": "horizontal"
        }
      }
    }
  ]
}
